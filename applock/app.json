{
  "expo": {
    "name": "ChallengeLock",
    "slug": "challengelock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.challengelock.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo as proof that you finished a chore challenge.",
        "NSPhotoLibraryUsageDescription": "Pick a photo as proof that you finished a chore challenge.",
        "NSMotionUsageDescription": "Count your steps for walking challenges.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.challengelock.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-audio",
      "expo-image-picker"
    ],
    "scheme": "challengelock",
    "experiments": {
      "typedRoutes": false
    }
  }
}
